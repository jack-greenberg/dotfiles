#!/bin/bash

alias reload='source ~/.zshrc'

# Directory listing

# Make it colorful
_OS=$(uname -s)
if [ $_OS = "Linux" ]
then
    alias ls='ls --color'
elif [ $_OS = "Darwin" ]
then
    alias ls='ls -G'
fi

alias l='ls -1F'
alias la='ls -lah'
alias td="git ls-tree -r --name-only HEAD | tree --fromfile"
alias lt='tree -aF'

# Tmux (not in tmux)
alias tml='tmux ls 2> /dev/null || echo "No tmux sessions."'
alias tma='tmux attach -t'
alias tmk='tmux kill-session -t'
alias tmd='tmux detach'
alias tmn='tmux new-session -s'

print_color () {
  for COLOR in {1..255};
  do
    echo -en "\e[38;5;${COLOR}m${COLOR} ";
  done;
}

# Copy/Paste
alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'
alias pwdc='pwd | pbcopy'
alias cdp='cd `pbpaste`'

# Git
alias gdog='git log --all --decorate --oneline --graph'
alias dot='git --git-dir=$HOME/.dot --work-tree=$HOME'
# Shows if there are any changed dotfiles
dot status --short

# Tools
extract () {
  if [ -f $1 ]; then
    case $1 in
      *.tar.bz2)  tar -jxvf $1                        ;;
      *.tar.gz)   tar -zxvf $1                        ;;
      *.bz2)      bunzip2 $1                          ;;
      *.gz)       gunzip $1                           ;;
      *.tar)      tar -xvf $1                         ;;
      *.tbz2)     tar -jxvf $1                        ;;
      *.tgz)      tar -zxvf $1                        ;;
      *.zip)      unzip $1                            ;;
      *.ZIP)      unzip $1                            ;;
      *.pax)      cat $1 | pax -r                     ;;
      *.pax.Z)    uncompress $1 --stdout | pax -r     ;;
      *.rar)      unrar x $1                          ;;
      *.Z)        uncompress $1                       ;;
      *)          echo "'$1' cannot be extracted/mounted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}
